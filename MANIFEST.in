include LICENSE NOTICE THIRD_PARTY_NOTICES.md README.md levels.yaml images.lock.json tools.lock.json
include release-images.lock.json
recursive-include devops_quests *.py *.json
recursive-include docs *
recursive-include quests *
recursive-include solutions *
recursive-include labs *
recursive-include locales *
recursive-include web *
recursive-include scripts *.py *.sh
recursive-include images *
