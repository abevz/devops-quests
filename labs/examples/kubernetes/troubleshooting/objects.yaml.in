apiVersion: v1
kind: Pod
metadata: {name: crash}
spec:
  containers:
  - name: app
    image: $DQ_APP_IMAGE
    imagePullPolicy: Never
    command: [sh, -c, 'echo configuration-missing >&2; exit 3']
---
apiVersion: v1
kind: Pod
metadata: {name: missing}
spec:
  containers:
  - name: app
    image: lab-missing:never
    imagePullPolicy: Never
