apiVersion: v1
kind: Pod
metadata: {name: oversized}
spec:
  containers:
  - name: app
    image: $DQ_APP_IMAGE
    imagePullPolicy: Never
    command: [sleep, '3600']
    resources: {requests: {cpu: '1000', memory: 16Mi}, limits: {cpu: '1000', memory: 32Mi}}
---
apiVersion: v1
kind: Pod
metadata: {name: bounded}
spec:
  containers:
  - name: app
    image: $DQ_APP_IMAGE
    imagePullPolicy: Never
    command: [sleep, '3600']
    resources: {requests: {cpu: 10m, memory: 16Mi}, limits: {cpu: 50m, memory: 32Mi}}
