apiVersion: v1
kind: ConfigMap
metadata: {name: settings}
data: {message: first}
---
apiVersion: v1
kind: Pod
metadata: {name: reader}
spec:
  containers:
  - name: app
    image: $DQ_APP_IMAGE
    imagePullPolicy: Never
    command: [sleep, '3600']
    env: [{name: MESSAGE, valueFrom: {configMapKeyRef: {name: settings, key: message}}}]
    volumeMounts: [{name: settings, mountPath: /settings}]
  volumes: [{name: settings, configMap: {name: settings}}]
