apiVersion: v1
kind: Pod
metadata: {name: web, labels: {app: web}}
spec:
  containers:
  - name: web
    image: $DQ_APP_IMAGE
    imagePullPolicy: Never
    command: [sh, -c, 'mkdir -p /tmp/site; echo lab-network > /tmp/site/index.html; httpd -f -p 8080 -h /tmp/site']
    readinessProbe: {httpGet: {path: /, port: 8080}, periodSeconds: 1}
---
apiVersion: v1
kind: Service
metadata: {name: web}
spec:
  selector: {app: wrong}
  ports: [{port: 80, targetPort: 8080}]
