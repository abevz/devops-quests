# Copy to .env for Docker Compose. Never commit populated credentials.
# No default account exists. Set BOTH values explicitly for first-start creation,
# or leave them empty and use the init-admin command.
DQ_ADMIN_USER=
DQ_ADMIN_PASSWORD=
# Container backend uses host networking so its default loopback bind is local.
# It controls Docker; run only as a trusted host operator.
DQ_PORT=8766
# Release assets are resolved and SHA256-verified before use.
DQ_VERSION=v1.0.0

# Optional admin-only release notice. OFF by default: no outbound update requests.
# Set DQ_UPDATE_CHECK=1 to allow GitHub Releases API checks (at most once per day).
DQ_UPDATE_CHECK=0
DQ_UPDATE_REPO=abevz/devops-quests
# Explicit installation hint: deploy, compose, or none. No installation guessing.
DQ_UPDATE_HINT=none
# A copyable command prefix for deploy mode; it is never executed by the web app.
DQ_UPDATE_DEPLOY_COMMAND=sudo /opt/devops-quests/operator/deploy.sh
