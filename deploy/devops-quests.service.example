[Unit]
Description=Local DevOps Quests
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=devops-quests
SupplementaryGroups=docker
WorkingDirectory=/opt/devops-quests/current
ExecStart=/opt/devops-quests/current/.venv/bin/python -m devops_quests serve --state /var/lib/devops-quests/runtime
UMask=0077
Restart=on-failure
# The trusted backend controls Docker. These filesystem settings do not turn
# Docker access into an unprivileged capability.
NoNewPrivileges=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
